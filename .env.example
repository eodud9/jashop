MYSQL_DATABASE=jashop
MYSQL_USER=jashop
MYSQL_PASSWORD=test
MYSQL_ROOT_PASSWORD=test

MYSQL_PORT=3308
REDIS_PORT=6379

# 아래 값은 Spring 실행 환경에 별도로 주입한다(Compose .env 자동 전달 아님).
# JASHOP_JWT_SECRET_BASE64: 32바이트 이상의 무작위 키를 Base64로 인코딩해 외부에서 주입.
# 실제 키를 이 파일이나 Git에 저장하지 않는다.
JASHOP_JWT_ISSUER=https://jashop.local
JASHOP_JWT_AUDIENCE=jashop-api
JASHOP_JWT_ACCESS_TTL_SECONDS=900
JASHOP_SECURITY_ALLOWED_ORIGINS=http://localhost:5173
